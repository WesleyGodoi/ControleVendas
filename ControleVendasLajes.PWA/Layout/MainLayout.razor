@inherits LayoutComponentBase

<div class="d-flex flex-column min-vh-100">
    <!-- Top Header -->
    <header class="app-header shadow-sm">
        <div class="container-fluid d-flex justify-content-between align-items-center px-3 max-w-900">
            <div class="d-flex align-items-center gap-2">
                <img src="icon-192.png" alt="Logo" style="width: 34px; height: 34px; border-radius: 8px;" />
                <div>
                    <h1 class="h6 mb-0 fw-bold text-dark">Controle de Lajes</h1>
                    <span class="text-muted" style="font-size: 11px;">Gestão Comercial</span>
                </div>
            </div>
            <div class="text-end">
                <span class="badge bg-light text-secondary border" style="font-size: 11px;">Por Wesley Godoi</span>
            </div>
        </div>
    </header>

    <!-- Main Page Body -->
    <main class="flex-grow-1">
        @Body
    </main>

    <!-- Bottom Navigation Bar for Mobile -->
    <nav class="bottom-nav">
        <NavLink href="" Match="NavLinkMatch.All" class="bottom-nav-item">
            <span class="icon">📊</span>
            <span>Início</span>
        </NavLink>
        <NavLink href="nova-venda" class="bottom-nav-item">
            <span class="icon">➕</span>
            <span>Nova Venda</span>
        </NavLink>
        <NavLink href="vendas" class="bottom-nav-item">
            <span class="icon">📋</span>
            <span>Vendas</span>
        </NavLink>
        <NavLink href="clientes" class="bottom-nav-item">
            <span class="icon">👥</span>
            <span>Clientes</span>
        </NavLink>
        <NavLink href="ajustes" class="bottom-nav-item">
            <span class="icon">⚙️</span>
            <span>Ajustes</span>
        </NavLink>
    </nav>
</div>

@page "/venda/{Id:int}"
@inject StorageDatabaseService Db
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="page-container">
    <div class="d-flex align-items-center justify-content-between mb-2">
        <div class="d-flex align-items-center gap-2">
            <a href="vendas" class="btn btn-sm btn-outline-secondary rounded-circle py-0 px-2">←</a>
            <h2 class="h6 fw-bold mb-0 text-dark">Venda #@Id</h2>
        </div>
        <div class="d-flex gap-1">
            <button class="btn btn-sm btn-outline-primary py-1 px-2" @onclick='() => Nav.NavigateTo($"editar-venda/{Id}")' title="Editar Venda">
                ✏️ Editar
            </button>
            <button class="btn btn-sm btn-outline-danger py-1 px-2" @onclick="ConfirmDeleteSale" title="Excluir Venda">
                🗑️
            </button>
        </div>
    </div>

    @if (CurrentSale == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
            <p class="text-muted mt-2 small">Carregando detalhes...</p>
        </div>
    }
    else
    {
        <!-- 1. Card Principal do Cliente e Laje -->
        <div class="card-app p-3">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
                        <h3 class="h6 fw-bold text-dark mb-0">@CurrentSale.ClientName</h3>
                        @if (!string.IsNullOrEmpty(CurrentSale.OrderNumber))
                        {
                            <span class="badge bg-light text-dark border fw-normal" style="font-size: 11px;">
                                📋 Pedido: @CurrentSale.OrderNumber
                            </span>
                        }
                    </div>
                    <div class="text-muted small" style="font-size: 11.5px;">
                        📞 @(string.IsNullOrEmpty(CurrentSale.ClientPhone) ? "Sem telefone" : CurrentSale.ClientPhone)
                    </div>
                </div>
                <span class="badge-app @GetStatusBadgeClass(CurrentSale.Status)">
                    @CurrentSale.StatusText
                </span>
            </div>

            <!-- Dados dos Itens da Laje -->
            <div class="bg-light p-2 rounded-2 mb-2 border">
                <span class="text-muted small fw-semibold d-block mb-1" style="font-size: 11px;">PRODUTOS / ITENS:</span>
                @if (CurrentSale.Items != null && CurrentSale.Items.Count > 0)
                {
                    <div class="d-flex flex-column gap-1 mb-2">
                        @foreach (var it in CurrentSale.Items)
                        {
                            <div class="bg-white p-2 rounded-2 border" style="font-size: 12px;">
                                <div class="d-flex justify-content-between fw-bold text-dark">
                                    <span>@it.ProductName</span>
                                    <span class="text-success">@it.TotalAmount.ToMoney()</span>
                                </div>
                                <div class="text-muted d-flex justify-content-between" style="font-size: 11px;">
                                    <span>@it.AreaSqm.ToString("N1") m² x @it.UnitPriceSqm.ToMoney()</span>
                                    @if (!string.IsNullOrEmpty(it.Notes))
                                    {
                                        <span class="fst-italic text-secondary">(@it.Notes)</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                <div class="d-flex justify-content-between pt-1 border-top">
                    <div>
                        <span class="text-muted small d-block" style="font-size: 10.5px;">ÁREA TOTAL</span>
                        <span class="fw-bold text-dark">@CurrentSale.AreaSqm.ToString("N1") m²</span>
                    </div>
                    <div class="text-end">
                        <span class="text-muted small d-block" style="font-size: 10.5px;">VALOR TOTAL</span>
                        <span class="fw-bold text-success fs-6">@CurrentSale.TotalAmount.ToMoney()</span>
                    </div>
                </div>
            </div>

            <!-- Endereço de Entrega -->
            <div class="mb-2" style="font-size: 12px;">
                <span class="text-muted fw-semibold">Entrega: </span>
                <span class="text-dark">@(string.IsNullOrEmpty(CurrentSale.DeliveryAddress) ? "Não informado" : CurrentSale.DeliveryAddress)</span>
            </div>

            <!-- Ações WhatsApp e Compartilhar -->
            <div class="d-flex gap-2">
                @if (!string.IsNullOrEmpty(CurrentSale.ClientPhone))
                {
                    <button class="btn btn-whatsapp btn-sm flex-grow-1 justify-content-center" @onclick="SendWhatsAppAsync">
                        <span>💬 Enviar no WhatsApp</span>
                    </button>
                }
                <button class="btn btn-outline-secondary btn-sm px-3" @onclick="ShareNativeAsync" title="Compartilhar">
                    📤
                </button>
            </div>
        </div>

        <!-- 2. Status da Negociação -->
        <div class="card-app p-3">
            <h4 class="small fw-bold text-dark mb-2">Status da Negociação</h4>
            <div class="btn-group w-100" role="group">
                <button type="button" class="btn btn-sm @(CurrentSale.Status == SaleStatus.Orcamento ? "btn-warning text-dark fw-bold" : "btn-outline-secondary")"
                        @onclick="() => UpdateNegotiationStatus(SaleStatus.Orcamento)">
                    📝 Orçamento
                </button>
                <button type="button" class="btn btn-sm @(CurrentSale.Status == SaleStatus.Fechado ? "btn-primary fw-bold" : "btn-outline-secondary")"
                        @onclick="() => UpdateNegotiationStatus(SaleStatus.Fechado)">
                    🤝 Fechado
                </button>
            </div>
        </div>

        <!-- 3. Controle de Entrega -->
        <div class="card-app p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h4 class="small fw-bold text-dark mb-0">Controle de Entrega</h4>
                <span class="badge-app @GetDeliveryBadgeClass(CurrentSale.DeliveryStatus)">
                    @CurrentSale.DeliveryStatusText
                </span>
            </div>

            <div class="btn-group w-100" role="group">
                <button type="button" class="btn btn-sm @(CurrentSale.DeliveryStatus == DeliveryStatus.Pendente ? "btn-danger fw-bold" : "btn-outline-secondary")"
                        @onclick="() => UpdateDeliveryStatus(DeliveryStatus.Pendente)">
                    Pendente
                </button>
                <button type="button" class="btn btn-sm @(CurrentSale.DeliveryStatus == DeliveryStatus.EmRota ? "btn-info text-dark fw-bold" : "btn-outline-secondary")"
                        @onclick="() => UpdateDeliveryStatus(DeliveryStatus.EmRota)">
                    Em Transporte
                </button>
                <button type="button" class="btn btn-sm @(CurrentSale.DeliveryStatus == DeliveryStatus.Entregue ? "btn-success fw-bold" : "btn-outline-secondary")"
                        @onclick="() => UpdateDeliveryStatus(DeliveryStatus.Entregue)">
                    Entregue
                </button>
            </div>
        </div>

        <!-- 4. Controle Financeiro e Pagamentos -->
        <div class="card-app p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h4 class="small fw-bold text-dark mb-0">Controle de Pagamentos</h4>
                <span class="badge-app @GetPaymentBadgeClass(CurrentSale.PaymentStatus)">
                    @CurrentSale.PaymentStatusText
                </span>
            </div>

            <div class="row g-2 mb-2 text-center">
                <div class="col-6">
                    <div class="bg-light p-2 rounded-2 border">
                        <small class="text-muted d-block" style="font-size: 10.5px;">TOTAL PAGO</small>
                        <span class="fw-bold text-success">@CurrentSale.TotalPaid.ToMoney()</span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="bg-light p-2 rounded-2 border">
                        <small class="text-muted d-block" style="font-size: 10.5px;">A RECEBER</small>
                        <span class="fw-bold text-danger">@CurrentSale.RemainingAmount.ToMoney()</span>
                    </div>
                </div>
            </div>

            <!-- Lista de Parcelas Recebidas -->
            @if (Payments.Count > 0)
            {
                <div class="mb-2">
                    <span class="text-muted small fw-semibold d-block mb-1" style="font-size: 11px;">PAGAMENTOS RECEBIDOS:</span>
                    <div class="d-flex flex-column gap-1">
                        @foreach (var p in Payments)
                        {
                            <div class="d-flex justify-content-between align-items-center bg-light p-1 px-2 rounded-2 border" style="font-size: 12px;">
                                <div>
                                    <span class="fw-bold text-success">@p.Amount.ToMoney()</span>
                                    <span class="badge bg-secondary ms-1" style="font-size: 10px;">@p.PaymentMethod</span>
                                    <span class="text-muted ms-1" style="font-size: 10.5px;">
                                        @p.PaymentDate.ToString("dd/MM/yyyy") @(string.IsNullOrEmpty(p.Notes) ? "" : $"• {p.Notes}")
                                    </span>
                                </div>
                                <button class="btn btn-sm btn-link text-danger p-0 ms-2" @onclick="() => DeletePaymentAsync(p.Id)" title="Excluir pagamento">
                                    ✕
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Botão Adicionar Pagamento -->
            <button class="btn btn-outline-primary btn-sm w-100 fw-semibold" @onclick="() => ShowAddPaymentModal = true">
                + Registrar Pagamento / Entrada
            </button>
        </div>
    }
</div>

<!-- Modal Adicionar Pagamento -->
@if (ShowAddPaymentModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header py-2">
                    <h6 class="modal-title fw-bold">Registrar Pagamento</h6>
                    <button type="button" class="btn-close" @onclick="() => ShowAddPaymentModal = false"></button>
                </div>
                <div class="modal-body py-2">
                    <div class="mb-2">
                        <label class="form-label small fw-semibold mb-0">Valor Recebido (R$) *</label>
                        <input type="number" step="0.01" class="form-control fw-bold text-success" @bind="NewPaymentAmount" />
                        <small class="text-muted" style="font-size: 11px;">Saldo restante: @CurrentSale?.RemainingAmount.ToMoney()</small>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold mb-0">Forma de Pagamento</label>
                        <select class="form-select form-select-sm" @bind="NewPaymentMethod">
                            <option value="PIX">PIX</option>
                            <option value="Dinheiro">Dinheiro</option>
                            <option value="Cartão de Crédito">Cartão de Crédito</option>
                            <option value="Cartão de Débito">Cartão de Débito</option>
                            <option value="Transferência Bancária">Transferência Bancária</option>
                            <option value="Boleto">Boleto</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold mb-0">Observação / Parcela</label>
                        <input type="text" class="form-control form-control-sm" @bind="NewPaymentNotes" placeholder="Ex: Entrada 50%, Parcela 1..." />
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="() => ShowAddPaymentModal = false">Cancelar</button>
                    <button type="button" class="btn btn-sm btn-success fw-bold" @onclick="SavePaymentAsync">Confirmar Recebimento</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Sale? CurrentSale;
    private List<SalePayment> Payments = new();

    // Modal Pagamento
    private bool ShowAddPaymentModal = false;
    private decimal NewPaymentAmount = 0;
    private string NewPaymentMethod = "PIX";
    private string NewPaymentNotes = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadSaleDataAsync();
    }

    private async Task LoadSaleDataAsync()
    {
        CurrentSale = await Db.GetSaleByIdAsync(Id);
        if (CurrentSale != null)
        {
            Payments = await Db.GetPaymentsBySaleIdAsync(Id);
            NewPaymentAmount = CurrentSale.RemainingAmount > 0 ? CurrentSale.RemainingAmount : 0;
        }
    }

    private async Task UpdateNegotiationStatus(SaleStatus newStatus)
    {
        if (CurrentSale == null) return;
        CurrentSale.Status = newStatus;
        await Db.SaveSaleAsync(CurrentSale);
    }

    private async Task UpdateDeliveryStatus(DeliveryStatus newStatus)
    {
        if (CurrentSale == null) return;
        CurrentSale.DeliveryStatus = newStatus;
        if (newStatus == DeliveryStatus.Entregue) CurrentSale.DeliveryDate = DateTime.Now;
        await Db.SaveSaleAsync(CurrentSale);
    }

    private async Task SavePaymentAsync()
    {
        if (CurrentSale == null || NewPaymentAmount <= 0) return;

        var payment = new SalePayment
        {
            SaleId = CurrentSale.Id,
            Amount = NewPaymentAmount,
            PaymentDate = DateTime.Now,
            PaymentMethod = NewPaymentMethod,
            Notes = NewPaymentNotes
        };

        await Db.AddPaymentAsync(payment);
        ShowAddPaymentModal = false;
        NewPaymentNotes = string.Empty;
        await LoadSaleDataAsync();
    }

    private async Task DeletePaymentAsync(int paymentId)
    {
        if (CurrentSale == null) return;
        await Db.DeletePaymentAsync(paymentId, CurrentSale.Id);
        await LoadSaleDataAsync();
    }

    private async Task ConfirmDeleteSale()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Tem certeza que deseja excluir esta venda/orçamento?");
        if (confirmed)
        {
            await Db.DeleteSaleAsync(Id);
            Nav.NavigateTo("vendas");
        }
    }

    private string BuildProposalText()
    {
        if (CurrentSale == null) return string.Empty;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("🧱 *ORÇAMENTO DE LAJES PRÉ-MOLDADAS*");
        sb.AppendLine("------------------------------------");
        sb.AppendLine($"👤 *Cliente:* {CurrentSale.ClientName}");
        if (!string.IsNullOrEmpty(CurrentSale.OrderNumber))
        {
            sb.AppendLine($"📋 *Pedido:* {CurrentSale.OrderNumber}");
        }
        if (!string.IsNullOrEmpty(CurrentSale.DeliveryAddress))
        {
            sb.AppendLine($"📍 *Entrega:* {CurrentSale.DeliveryAddress}");
        }
        sb.AppendLine("------------------------------------");
        sb.AppendLine("📦 *PRODUTOS / ITENS:*");

        if (CurrentSale.Items != null && CurrentSale.Items.Count > 0)
        {
            foreach (var it in CurrentSale.Items)
            {
                var note = !string.IsNullOrEmpty(it.Notes) ? $" ({it.Notes})" : "";
                sb.AppendLine($"• {it.ProductName}: {it.AreaSqm:N1} m² x {it.UnitPriceSqm.ToMoney()} = {it.TotalAmount.ToMoney()}{note}");
            }
        }
        else
        {
            sb.AppendLine($"• {CurrentSale.ProductName}: {CurrentSale.AreaSqm:N1} m² x {CurrentSale.UnitPriceSqm.ToMoney()} = {CurrentSale.TotalAmount.ToMoney()}");
        }

        sb.AppendLine("------------------------------------");
        sb.AppendLine($"📐 *METRAGEM TOTAL:* {CurrentSale.AreaSqm:N1} m²");
        sb.AppendLine($"💰 *VALOR TOTAL:* {CurrentSale.TotalAmount.ToMoney()}");
        sb.AppendLine("------------------------------------");
        sb.AppendLine($"Emitido em: {CurrentSale.SaleDate:dd/MM/yyyy}");
        sb.AppendLine($"Status: {CurrentSale.StatusText}");
        sb.AppendLine();
        sb.AppendLine("*Desenvolvido por Wesley Godoi*");

        return sb.ToString();
    }

    private async Task SendWhatsAppAsync()
    {
        if (CurrentSale == null) return;
        var text = BuildProposalText();
        await JS.InvokeVoidAsync("openWhatsApp", CurrentSale.ClientPhone, text);
    }

    private async Task ShareNativeAsync()
    {
        if (CurrentSale == null) return;
        var text = BuildProposalText();
        var shared = await JS.InvokeAsync<bool>("shareNative", $"Orçamento - {CurrentSale.ClientName}", text);
        if (!shared)
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            await JS.InvokeVoidAsync("alert", "Texto do orçamento copiado para a área de transferência!");
        }
    }

    private string GetStatusBadgeClass(SaleStatus status) => status switch
    {
        SaleStatus.Orcamento => "badge-orcamento",
        SaleStatus.Fechado => "badge-fechado",
        _ => "badge-orcamento"
    };

    private string GetDeliveryBadgeClass(DeliveryStatus status) => status switch
    {
        DeliveryStatus.Entregue => "badge-entregue",
        DeliveryStatus.EmRota => "badge-transporte",
        _ => "badge-pendente"
    };

    private string GetPaymentBadgeClass(PaymentStatus status) => status switch
    {
        PaymentStatus.Pago => "badge-pago",
        PaymentStatus.Parcial => "badge-parcial",
        _ => "badge-pendente"
    };
}

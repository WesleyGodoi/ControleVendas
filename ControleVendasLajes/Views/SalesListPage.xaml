<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ControleVendasLajes.ViewModels"
             xmlns:models="clr-namespace:ControleVendasLajes.Models"
             x:Class="ControleVendasLajes.Views.SalesListPage"
             x:Name="SalesPageRoot"
             x:DataType="vm:SalesListViewModel"
             Title="Venda"
             BackgroundColor="#F4F6F9">

    <Grid>
        <Grid RowDefinitions="Auto, Auto, *">

            <!-- 1. PAINEL DE FILTROS ELEGANTE -->
            <Border Grid.Row="0" 
                    BackgroundColor="#FFFFFF" 
                    Stroke="#E5E9F0" 
                    StrokeThickness="1" 
                    Margin="18,12,18,6" 
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    
                    <!-- Busca por cliente ou laje -->
                    <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" Padding="12,2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto, *">
                            <Label Text="🔍" FontSize="14" VerticalOptions="Center" Margin="0,0,8,0" TextColor="#94A3B8" />
                            <Entry Grid.Column="1"
                                   Placeholder="Buscar por cliente ou tipo de laje..."
                                   Text="{Binding SearchClientText}"
                                   FontSize="14"
                                   TextColor="#0F172A"
                                   BackgroundColor="Transparent"
                                   ClearButtonVisibility="WhileEditing" />
                        </Grid>
                    </Border>

                    <!-- Filtros Rápidos de Entrega e Pagamento -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" Padding="10,4">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="1">
                                <Label Text="ENTREGA" FontSize="9" FontAttributes="Bold" TextColor="#64748B" />
                                <Picker ItemsSource="{Binding DeliveryFilterOptions}"
                                        SelectedIndex="{Binding SelectedDeliveryIndex}"
                                        SelectedItem="{Binding SelectedDeliveryFilter}"
                                        SelectedIndexChanged="OnDeliveryFilterSelectedIndexChanged"
                                        FontSize="13"
                                        TextColor="#0A84FF" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" Padding="10,4">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="1">
                                <Label Text="PAGAMENTO" FontSize="9" FontAttributes="Bold" TextColor="#64748B" />
                                <Picker ItemsSource="{Binding PaymentFilterOptions}"
                                        SelectedIndex="{Binding SelectedPaymentIndex}"
                                        SelectedItem="{Binding SelectedPaymentFilter}"
                                        SelectedIndexChanged="OnPaymentFilterSelectedIndexChanged"
                                        FontSize="13"
                                        TextColor="#0A84FF" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Toggle Data -->
                    <Grid ColumnDefinitions="*, Auto" HeightRequest="32">
                        <Label Text="Filtrar por período de data" FontSize="13" TextColor="#334155" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding FilterByDate}" OnColor="#0A84FF" />
                    </Grid>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" IsVisible="{Binding FilterByDate}">
                        <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" Padding="10,4">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="1">
                                <Label Text="DE" FontSize="10" FontAttributes="Bold" TextColor="#94A3B8" />
                                <DatePicker Date="{Binding StartDate}" Format="dd/MM/yyyy" FontSize="13" TextColor="#0A84FF" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" Padding="10,4">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="1">
                                <Label Text="ATÉ" FontSize="10" FontAttributes="Bold" TextColor="#94A3B8" />
                                <DatePicker Date="{Binding EndDate}" Format="dd/MM/yyyy" FontSize="13" TextColor="#0A84FF" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Button Text="Limpar Filtros"
                            Command="{Binding ClearFiltersCommand}"
                            BackgroundColor="#F1F5F9"
                            TextColor="#64748B"
                            FontSize="12"
                            FontAttributes="Bold"
                            HeightRequest="34"
                            CornerRadius="8"
                            Padding="0" />
                </VerticalStackLayout>
            </Border>

            <!-- 2. TOTALIZADORES -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto, *, *" ColumnSpacing="8" Padding="18,4,18,6">
                <Border BackgroundColor="#EAF2FF" StrokeThickness="0" Padding="12,8">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="1">
                        <Label Text="PEDIDOS" FontSize="10" FontAttributes="Bold" TextColor="#0A84FF" />
                        <Label Text="{Binding TotalSalesCount}" FontSize="16" FontAttributes="Bold" TextColor="#0A84FF" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" BackgroundColor="#FFFFFF" Stroke="#E5E9F0" StrokeThickness="1" Padding="12,8">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="1">
                        <Label Text="TOTAL M²" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
                        <Label Text="{Binding TotalFilteredSqm, StringFormat='{0:N1} m²'}" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2" BackgroundColor="#FFFFFF" Stroke="#E5E9F0" StrokeThickness="1" Padding="12,8">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="1">
                        <Label Text="TOTAL VALOR" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
                        <Label Text="{Binding TotalFilteredRevenue, StringFormat='R$ {0:N0}'}" FontSize="15" FontAttributes="Bold" TextColor="#10B981" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- 3. LISTA DE VENDAS -->
            <CollectionView Grid.Row="2" 
                            ItemsSource="{Binding FilteredSales}" 
                            Margin="18,4,18,90"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedSale, Mode=TwoWay}"
                            SelectionChangedCommand="{Binding OpenSaleDetailCommand}"
                            SelectionChangedCommandParameter="{Binding SelectedSale}">
                <CollectionView.EmptyView>
                    <Border BackgroundColor="#FFFFFF" Stroke="#E5E9F0" StrokeThickness="1" Padding="28" Margin="0,20">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                            <Label Text="🔍" FontSize="36" HorizontalOptions="Center" />
                            <Label Text="Nenhum resultado encontrado" FontAttributes="Bold" FontSize="15" TextColor="#1E293B" HorizontalOptions="Center" />
                            <Label Text="Tente ajustar os filtros acima." FontSize="13" TextColor="#94A3B8" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Sale">
                        <Border BackgroundColor="#FFFFFF" Stroke="#E5E9F0" StrokeThickness="1" Padding="14" Margin="0,0,0,10">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer 
                                    x:DataType="{x:Null}"
                                    Command="{Binding Source={x:Reference SalesPageRoot}, Path=BindingContext.OpenSaleDetailCommand}" 
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto">
                                
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding ClientName}" FontAttributes="Bold" FontSize="16" TextColor="#0F172A" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding TotalAmount, StringFormat='R$ {0:N2}'}" FontAttributes="Bold" FontSize="16" TextColor="#0A84FF" />

                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding ProductName}" FontSize="13" TextColor="#64748B" Margin="0,4,0,0" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding AreaSqm, StringFormat='{0:N1} m²'}" FontSize="13" FontAttributes="Bold" TextColor="#334155" HorizontalTextAlignment="End" Margin="0,4,0,0" />

                                <!-- Duplo Status: Entrega e Pagamento -->
                                <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="Auto, Auto, *" ColumnSpacing="6" Margin="0,10,0,0">
                                    <Border BackgroundColor="{Binding DeliveryStatusColor}" StrokeThickness="0" Padding="8,3">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                        <Label Text="{Binding DeliveryStatusText}" FontSize="10" FontAttributes="Bold" TextColor="#FFFFFF" />
                                    </Border>

                                    <Border Grid.Column="1" BackgroundColor="{Binding PaymentStatusColor}" StrokeThickness="0" Padding="8,3">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                        <Label Text="{Binding PaymentStatusText}" FontSize="10" FontAttributes="Bold" TextColor="#FFFFFF" />
                                    </Border>

                                    <Label Grid.Column="2" Text="{Binding SaleDate, StringFormat='📅 {0:dd/MM/yyyy}'}" FontSize="11" TextColor="#94A3B8" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <VerticalStackLayout Padding="0,16,0,24" HorizontalOptions="Center">
                        <Label Text="Desenvolvido por Wesley Godoi" 
                               FontSize="11" 
                               FontAttributes="Bold" 
                               TextColor="#94A3B8" 
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>

        </Grid>

        <!-- 4. BOTÃO FLUTUANTE '+' PARA NOVA VENDA -->
        <Border HorizontalOptions="End" 
                VerticalOptions="End" 
                Margin="0,0,22,24" 
                WidthRequest="60" 
                HeightRequest="60" 
                BackgroundColor="#0A84FF" 
                StrokeThickness="0">
            <Border.StrokeShape><RoundRectangle CornerRadius="30" /></Border.StrokeShape>
            <Button Text="+" 
                    Command="{Binding NavigateToNewSaleCommand}" 
                    BackgroundColor="Transparent" 
                    TextColor="#FFFFFF" 
                    FontSize="32" 
                    FontAttributes="Bold" 
                    Padding="0" 
                    WidthRequest="60" 
                    HeightRequest="60" />
        </Border>

    </Grid>

</ContentPage>

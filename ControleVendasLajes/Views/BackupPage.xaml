<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ControleVendasLajes.ViewModels"
             x:Class="ControleVendasLajes.Views.BackupPage"
             x:Name="BackupPageRoot"
             x:DataType="vm:BackupViewModel"
             Title="Backup e Segurança"
             BackgroundColor="#F4F6F9">

    <Grid>
        <!-- Conteúdo Rolável -->
        <ScrollView>
            <VerticalStackLayout Spacing="16" Padding="18,14,18,30">

                <!-- 1. HEADER EXPLICATIVO -->
                <Border BackgroundColor="#0A84FF" StrokeThickness="0" Padding="18,16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14">
                        <Border BackgroundColor="#FFFFFF" WidthRequest="48" HeightRequest="48" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                            <Label Text="🛡️" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Segurança dos Dados" FontSize="17" FontAttributes="Bold" TextColor="#FFFFFF" />
                            <Label Text="Gere cópias de segurança para nunca perder seus registros de vendas e clientes." 
                                   FontSize="12" 
                                   TextColor="#E0F2FE" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- 2. CARD: RESUMO DA BASE DE DADOS -->
                <Border BackgroundColor="#FFFFFF" Stroke="#E5E9F0" StrokeThickness="1" Padding="16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="ESTATÍSTICAS DA BASE LOCAL" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="#64748B" 
                               CharacterSpacing="1" />

                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" RowSpacing="10" ColumnSpacing="10">
                            <!-- Clientes -->
                            <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" Padding="12,10">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="👥 Clientes" FontSize="11" FontAttributes="Bold" TextColor="#64748B" />
                                    <Label Text="{Binding ClientCount}" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Vendas -->
                            <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" Padding="12,10">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="🏗️ Vendas" FontSize="11" FontAttributes="Bold" TextColor="#64748B" />
                                    <Label Text="{Binding SaleCount}" FontSize="20" FontAttributes="Bold" TextColor="#0A84FF" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Pagamentos -->
                            <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" Padding="12,10">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="💰 Pagamentos" FontSize="11" FontAttributes="Bold" TextColor="#64748B" />
                                    <Label Text="{Binding PaymentCount}" FontSize="20" FontAttributes="Bold" TextColor="#10B981" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Tamanho do Banco -->
                            <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" Padding="12,10">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="💾 Tamanho" FontSize="11" FontAttributes="Bold" TextColor="#64748B" />
                                    <Label Text="{Binding DatabaseSizeText}" FontSize="18" FontAttributes="Bold" TextColor="#334155" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F1F5F9" Margin="0,4" />

                        <!-- Data do Último Backup -->
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="🕒 Último backup:" FontSize="12" TextColor="#64748B" />
                            <Label Text="{Binding LastBackupText}" FontSize="12" FontAttributes="Bold" TextColor="#0F172A" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- 3. CARD: FAZER BACKUP -->
                <Border BackgroundColor="#FFFFFF" Stroke="#E5E9F0" StrokeThickness="1" Padding="18">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="📦" FontSize="18" VerticalOptions="Center" />
                            <Label Text="Exportar Backup (Criar Cópia)" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        
                        <Label Text="Cria um arquivo com todos os dados do sistema. No Windows, ele é salvo automaticamente na sua pasta Downloads e pode ser compartilhado para seu Google Drive, WhatsApp ou pen drive." 
                               FontSize="13" 
                               TextColor="#64748B" />

                        <Button Text="📦 Fazer Backup Agora" 
                                Command="{Binding CreateBackupCommand}"
                                BackgroundColor="#0A84FF" 
                                TextColor="#FFFFFF" 
                                FontAttributes="Bold" 
                                FontSize="14" 
                                CornerRadius="12" 
                                HeightRequest="46" 
                                Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- 4. CARD: RESTAURAR BACKUP -->
                <Border BackgroundColor="#FFFFFF" Stroke="#E5E9F0" StrokeThickness="1" Padding="18">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="📥" FontSize="18" VerticalOptions="Center" />
                            <Label Text="Restaurar Backup (Recuperar Dados)" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Label Text="Selecione um arquivo de backup previamente gerado (.db3) para restaurar todos os clientes, vendas e pagamentos." 
                               FontSize="13" 
                               TextColor="#64748B" />

                        <!-- Alerta visual de segurança -->
                        <Border BackgroundColor="#FFFBEB" Stroke="#FDE68A" StrokeThickness="1" Padding="12,8">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="⚠️" FontSize="16" VerticalOptions="Center" />
                                <Label Text="A restauração substituirá os registros atuais pelo conteúdo do backup." 
                                       FontSize="12" 
                                       TextColor="#B45309" 
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Button Text="📥 Selecionar Arquivo de Backup" 
                                Command="{Binding RestoreBackupCommand}"
                                BackgroundColor="#1E293B" 
                                TextColor="#FFFFFF" 
                                FontAttributes="Bold" 
                                FontSize="14" 
                                CornerRadius="12" 
                                HeightRequest="46" 
                                Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Rodapé -->
                <VerticalStackLayout HorizontalOptions="Center" Margin="0,10,0,10">
                    <Label Text="Desenvolvido por Wesley Godoi" 
                           FontSize="11" 
                           FontAttributes="Bold" 
                           TextColor="#94A3B8" 
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Overlay de Carregamento / Progresso -->
        <Grid IsVisible="{Binding IsBusy}" 
              BackgroundColor="#80000000" 
              HorizontalOptions="Fill" 
              VerticalOptions="Fill">
            <Border BackgroundColor="#FFFFFF" 
                    StrokeThickness="0" 
                    Padding="24,20" 
                    HorizontalOptions="Center" 
                    VerticalOptions="Center" 
                    WidthRequest="280">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" 
                                       Color="#0A84FF" 
                                       WidthRequest="38" 
                                       HeightRequest="38" 
                                       HorizontalOptions="Center" />
                    <Label Text="{Binding BusyStatusText}" 
                           FontSize="14" 
                           FontAttributes="Bold" 
                           TextColor="#0F172A" 
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>

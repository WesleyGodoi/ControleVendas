<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ControleVendasLajes.ViewModels"
             xmlns:models="clr-namespace:ControleVendasLajes.Models"
             x:Class="ControleVendasLajes.Views.ClientsPage"
             x:Name="ClientsPageRoot"
             x:DataType="vm:ClientsViewModel"
             Title="Clientes"
             BackgroundColor="#F2F2F7">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16,12,16,24">
            
            <!-- Formulário de Cadastro / Edição -->
            <Border BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="{Binding FormTitle}" FontSize="12" FontAttributes="Bold" TextColor="#007AFF" VerticalOptions="Center" />
                        <Button Grid.Column="1" 
                                Text="Cancelar Edição" 
                                Command="{Binding CancelEditCommand}" 
                                IsVisible="{Binding IsEditing}"
                                BackgroundColor="Transparent"
                                TextColor="#FF3B30"
                                FontSize="12"
                                HeightRequest="32"
                                Padding="8,0" />
                    </Grid>

                    <Entry Placeholder="Nome completo / Razão Social *"
                           Text="{Binding Name}"
                           FontSize="15"
                           ClearButtonVisibility="WhileEditing" />

                    <Entry Placeholder="Telefone / WhatsApp (com DDD)"
                           Text="{Binding Phone}"
                           Keyboard="Telephone"
                           FontSize="15"
                           ClearButtonVisibility="WhileEditing" />

                    <BoxView HeightRequest="0.5" Color="#E5E5EA" Margin="0,4" />

                    <Label Text="ENDEREÇO DA OBRA (ENTREGA)" FontSize="12" FontAttributes="Bold" TextColor="#007AFF" />

                    <!-- Rua e Número -->
                    <Grid ColumnDefinitions="*, 110" ColumnSpacing="10">
                        <Entry Grid.Column="0"
                               Placeholder="Rua / Logradouro *"
                               Text="{Binding Street}"
                               FontSize="15"
                               ClearButtonVisibility="WhileEditing" />

                        <Entry Grid.Column="1"
                               Placeholder="Nº / Lote"
                               Text="{Binding Number}"
                               FontSize="15"
                               ClearButtonVisibility="WhileEditing" />
                    </Grid>

                    <!-- Bairro e Cidade -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <Entry Grid.Column="0"
                               Placeholder="Bairro"
                               Text="{Binding Neighborhood}"
                               FontSize="15"
                               ClearButtonVisibility="WhileEditing" />

                        <Entry Grid.Column="1"
                               Placeholder="Cidade"
                               Text="{Binding City}"
                               FontSize="15"
                               ClearButtonVisibility="WhileEditing" />
                    </Grid>

                    <!-- Observação -->
                    <Editor Placeholder="Observação (Ex: Ponto de referência, portão dos fundos, etc.)"
                            Text="{Binding Notes}"
                            AutoSize="TextChanges"
                            HeightRequest="60"
                            FontSize="14" />

                    <Button Text="{Binding IsEditing, Converter={x:Null}, StringFormat='Salvar Cliente'}"
                            Command="{Binding SaveClientCommand}"
                            BackgroundColor="#007AFF"
                            TextColor="#FFFFFF"
                            FontSize="16"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="48"
                            Margin="0,6,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Lista de Clientes com Botões de Editar e Excluir -->
            <VerticalStackLayout Spacing="8">
                <Label Text="CLIENTES CADASTRADOS" FontSize="12" FontAttributes="Bold" TextColor="#6D6D72" Margin="6,0,0,4" />

                <CollectionView ItemsSource="{Binding Clients}">
                    <CollectionView.EmptyView>
                        <Label Text="Nenhum cliente cadastrado ainda." 
                               HorizontalOptions="Center" 
                               Margin="0,30,0,0" 
                               TextColor="#8E8E93" 
                               FontSize="14" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Client">
                            <Border BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="14" Margin="0,0,0,8">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                                    
                                    <VerticalStackLayout Grid.Column="0" Grid.Row="0" Spacing="4">
                                        <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="#1C1C1E" />
                                        <Label Text="{Binding Phone}" FontSize="13" TextColor="#007AFF" />
                                        <Label Text="{Binding DeliveryAddress, StringFormat='📍 {0}'}" FontSize="13" TextColor="#8E8E93" />
                                    </VerticalStackLayout>

                                    <!-- Botões de Ação: Editar e Excluir -->
                                    <HorizontalStackLayout Grid.Column="1" Grid.Row="0" Spacing="6" VerticalOptions="Start">
                                        <Button Text="✏️"
                                                ToolTipProperties.Text="Editar Cliente"
                                                BackgroundColor="#F2F2F7"
                                                TextColor="#007AFF"
                                                WidthRequest="38"
                                                HeightRequest="38"
                                                CornerRadius="8"
                                                Padding="0"
                                                x:DataType="{x:Null}"
                                                Command="{Binding Source={x:Reference ClientsPageRoot}, Path=BindingContext.StartEditCommand}"
                                                CommandParameter="{Binding .}" />

                                        <Button Text="🗑️"
                                                ToolTipProperties.Text="Excluir Cliente"
                                                BackgroundColor="#FEECEB"
                                                TextColor="#FF3B30"
                                                WidthRequest="38"
                                                HeightRequest="38"
                                                CornerRadius="8"
                                                Padding="0"
                                                x:DataType="{x:Null}"
                                                Command="{Binding Source={x:Reference ClientsPageRoot}, Path=BindingContext.DeleteClientCommand}"
                                                CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Rodapé de Autoria -->
            <VerticalStackLayout HorizontalOptions="Center" Padding="0,8,0,16">
                <Label Text="Desenvolvido por Wesley Godoi" 
                       FontSize="11" 
                       FontAttributes="Bold" 
                       TextColor="#94A3B8" 
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
